  \node[visible on=<5->, sline] at (0.65,-1.54) {\ \ \ \ \ \ \ \ \ = 0.00 + 0.50 = 0.50};

  \node[visible on=<6->, slineDim] at (0.3,-2.00) {Then $\sigma$ squeezes it back into range.};
  \node[visible on=<6->, slineDim] at (0.3,-2.28) {Both numbers already sit inside};
  \node[visible on=<6->, slineDim] at (0.3,-2.56) {[0,1], so nothing changes this time.};

