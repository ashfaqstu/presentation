  \node[anchor=north, text=gold, font=\fontsize{15}{18}\selectfont\sffamily\bfseries, align=center]
    at (0, -1.0) {``Not every relationship is equally useful.''} ;
  \node[anchor=north, text=dimtext, font=\fontsize{9}{11}\selectfont\sffamily, align=center]
    at (0, -1.8) {Every modern GNN variant is simply a refined way of answering:\\how to gather, how to aggregate, or who to listen to.};
\end{tikzpicture}
\end{frame}

