% --- 15.2: Case Study 3 · CERN LHC Solution ---
\begin{frame}[plain]
\kicker{SCENE 15 / 17 \quad CASE STUDY 3: PARTICLE PHYSICS}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  \begin{scope}[shift={(-3.4, 0.2)}]
