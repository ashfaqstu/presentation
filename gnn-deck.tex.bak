    at (3.0, 0.5) {What if we keep them?};

  \node[anchor=south, text=crimson!90!chalk, font=\fontsize{11}{13}\selectfont\sffamily\itshape, align=center]
    at (-3.0, -2.5) {Throw away the relationships\\$\rightarrow$ \textbf{throw away the answer.}};
\end{tikzpicture}
\end{frame}

