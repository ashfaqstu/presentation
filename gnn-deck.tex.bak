  \node[acard] at (E) {\textbf{Eve}\\[1pt]\fontsize{6.5}{7.5}\selectfont Topic X: No};
  \node[acard] at (B) {\textbf{Bob}\\[1pt]\fontsize{6.5}{7.5}\selectfont Topic X: YES};
  \node[acard] at (C) {\textbf{Carol}\\[1pt]\fontsize{6.5}{7.5}\selectfont Topic X: YES};

  \node[draw=gold, fill=gold!20, rounded corners=3pt, line width=2pt,
        text width=4.6cm, inner ysep=8pt, align=center] at (A) {
    \textbf{\large ALICE}\\[2pt]
    \fontsize{7.5}{8.5}\selectfont Combine: Old Card + Neighbours\\[3pt]
    \textcolor{biogreen!90!ink}{\fontsize{8.5}{9.5}\selectfont\bfseries LIKELY INTERESTED: 89\%}
  };

  \node[chipFocus] at (0, -2.6) {STEP 4: UPDATE $\cdot$ Alice rewrites her representation};
\end{tikzpicture}
\end{frame}

