    \node[anchor=north west, text=ink, font=\dispfont\huge\bfseries] at (-2.1, 1.6) {Connect Dots};
    \node[anchor=north west, text=ink!85, font=\fontsize{7.5}{9}\selectfont\sffamily, text width=4.1cm] at (-2.1, 0.7) {
      $\bullet$ Builds graph of candidate hits.\\[3pt]
