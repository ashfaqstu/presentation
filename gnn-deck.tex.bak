    \node[anchor=center, text=biogreen!90!ink, font=\fontsize{7.5}{8.5}\selectfont\twfont\bfseries] at (0,-1.75) {Killed Pan-Resistant Bacteria};
  \end{scope}

  % Molecule graph right
  \begin{scope}[shift={(3.2, 0.2)}]
    \node[anchor=north, text=brass, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries] at (0, 1.9) {HALICIN GRAPH REPRESENTATION};
    \coordinate (c1) at ( 0.0,  1.1);
    \coordinate (c2) at (-1.2,  0.4);
    \coordinate (c3) at (-1.2, -0.6);
    \coordinate (c4) at ( 0.0, -1.3);
    \coordinate (c5) at ( 1.2, -0.6);
