\documentclass[aspectratio=169,11pt]{beamer}

% Suppress default beamer navigation symbols
\setbeamertemplate{navigation symbols}{}

% Packages
\usepackage{fontspec}
\usepackage{tikz}
\usepackage{amsmath,amssymb}
\usepackage{ulem} % for \sout

% TikZ Libraries
\usetikzlibrary{arrows.meta,calc,positioning,shapes.geometric,backgrounds,fit}

% ─────────────────────────────────────────────────────────────
% Color Palette: Dark Corkboard Detective Aesthetic
% ─────────────────────────────────────────────────────────────
\definecolor{boardbg}{HTML}{1A130F}     % Dark corkboard / slate
\definecolor{boardmid}{HTML}{271E18}    % Lighter corkboard tone
\definecolor{papercream}{HTML}{E8DCC4}  % Primary parchment paper card
\definecolor{paperdark}{HTML}{C6B08A}   % Shaded parchment footer band
\definecolor{crimson}{HTML}{C1272D}     % Detective red string / alert
\definecolor{brass}{HTML}{C9A66B}       % Brass pin / golden label
\definecolor{gold}{HTML}{F0C46A}        % Vivid gold highlight
\definecolor{chalk}{HTML}{F2EBDD}       % White chalk text
\definecolor{dimtext}{HTML}{93826C}     % Muted annotation text
\definecolor{ink}{HTML}{14100E}         % Near-black typewriter ink
\definecolor{skyblue}{HTML}{6BA4B8}     % Cool blue accent
\definecolor{biogreen}{HTML}{5E9E68}    % Success / biology green

% Set beamer background
\setbeamercolor{background canvas}{bg=boardbg}

% ─────────────────────────────────────────────────────────────
% Typography (System Fonts)
% ─────────────────────────────────────────────────────────────
\setsansfont{Segoe UI}
\setmonofont{Courier New}
\newfontfamily\dispfont{Impact}
\newfontfamily\twfont{Courier New}

% ─────────────────────────────────────────────────────────────
% TikZ Styles
% ─────────────────────────────────────────────────────────────
\tikzset{
  gedge/.style={draw=crimson, line width=1.4pt},
  gedgeDim/.style={draw=dimtext!40, line width=0.8pt},
  gedgeVisible/.style={draw=brass!55, line width=0.9pt},
  gedgeHot/.style={draw=gold, line width=2.4pt},
  gnode/.style={circle, draw=brass, fill=boardmid, line width=1.5pt, minimum size=20pt, align=center},
  gnodeFocus/.style={circle, draw=gold, fill=boardmid, line width=2.5pt, minimum size=24pt, align=center},
  gnodeDim/.style={circle, draw=dimtext!50, fill=boardmid!80, line width=1.2pt, minimum size=20pt, align=center},
  gnodeWash/.style={circle, draw=chalk!60, fill=chalk!85, line width=1.2pt, minimum size=20pt, align=center},
  chip/.style={draw=brass!60, fill=boardmid, text=chalk, rounded corners=2pt, inner xsep=8pt, inner ysep=4pt, font=\fontsize{7.5}{9}\selectfont\twfont, align=center},
  chipFocus/.style={draw=gold, fill=boardmid, text=gold, rounded corners=2pt, inner xsep=8pt, inner ysep=4pt, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries, align=center},
  bankbadge/.style={draw=brass, fill=boardmid, text=brass, rounded corners=2pt, inner xsep=8pt, inner ysep=4pt, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries, align=center},
  scambadge/.style={draw=crimson, fill=boardmid, text=crimson!85!white, rounded corners=2pt, inner xsep=8pt, inner ysep=4pt, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries, align=center},
  acard/.style={fill=papercream, text=ink, rounded corners=3pt, inner xsep=8pt, inner ysep=5pt, font=\fontsize{7.5}{9}\selectfont\sffamily, align=center},
  acardFocus/.style={draw=gold, line width=1.6pt, fill=papercream, text=ink, rounded corners=3pt, inner xsep=10pt, inner ysep=6pt, font=\fontsize{8}{10}\selectfont\sffamily, align=center}
}

% Header kicker macro
\newcommand{\kicker}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west, text=brass,
          font=\fontsize{7}{7}\selectfont\twfont\bfseries,
          inner sep=0] at (current page.north west)
          [xshift=0.65cm, yshift=-0.38cm] {#1};
  \end{tikzpicture}%
}

\begin{document}

% =============================================================
% ACT I: THE GAP
% =============================================================

% --- 1.1: Cold Open · Suspect Alone ---
\begin{frame}[plain]
\kicker{SCENE 01 / 17 \quad COLD OPEN}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  \node[anchor=south, text=chalk, font=\fontsize{13}{15}\selectfont\sffamily\bfseries, align=center]
    at (0,2.45) {Is this person trustworthy?};
  \node[anchor=south, text=dimtext, font=\fontsize{8.5}{10}\selectfont\sffamily, align=center]
    at (0,2.1) {With only their own data, you cannot decide.};

  \fill[papercream, rounded corners=3pt] (-3.1,-1.5) rectangle (3.1,1.6);
  \fill[paperdark, rounded corners=3pt, opacity=0.5] (-3.1,-1.5) rectangle (3.1,-0.55);
  \fill[crimson] (0,1.6) circle (5pt);
  
  \node[anchor=north, text=ink!70, font=\fontsize{6.5}{8}\selectfont\twfont\bfseries]
    at (0,1.42) {PROFILE FILE $\cdot$ TARGET \#4091};
  \node[anchor=north, text=ink, font=\dispfont\LARGE\bfseries]
    at (0,1.08) {PERSON OF INTEREST};
  \node[anchor=north, text=ink!80!boardbg, font=\fontsize{7.5}{9}\selectfont\twfont]
    at (0,0.52) {LOCATION: DHAKA, BD \quad AGE: 24};
  \node[anchor=north, text=ink!80!boardbg, font=\fontsize{7.5}{9}\selectfont\twfont]
    at (0,0.22) {POSTS: 17 \quad STATUS: NORMAL USER};
  \draw[ink!20, line width=0.5pt] (-2.5,-0.08) -- (2.5,-0.08);
  
  \node[anchor=center, text=ink!90, font=\fontsize{8}{10}\selectfont\sffamily\itshape, align=center]
    at (0,-1.02) {Can you decide if this person is trustworthy?};

  \node[anchor=south, text=dimtext, font=\small\sffamily\itshape, align=center]
    at (0,-3.4) {Twenty-four years old. Seventeen posts. Lives in Dhaka.};
\end{tikzpicture}
\end{frame}

