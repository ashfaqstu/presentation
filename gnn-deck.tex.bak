    \draw[gedge] (c1)--(c2)--(c3)--(c4)--(c5)--(c6)--(c1);
    \draw[gedge] (c1)--(c4);
    \draw[gedge] (c1)--(0, 1.8);
    \draw[gedge] (c4)--(0,-2.0);
    \foreach \coord in {c1,c2,c3,c4,c5,c6} {
      \node[circle, draw=brass, fill=boardmid, text=gold, font=\fontsize{6.5}{7.5}\selectfont\twfont, inner sep=1pt] at (\coord) {C};
    }
