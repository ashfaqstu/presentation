    \node[circle, draw=brass, fill=boardmid, text=chalk, font=\fontsize{6.5}{7.5}\selectfont\twfont, inner sep=1pt] at (0,-2.0) {N};
  \end{scope}

  \node[anchor=south, text=chalk, font=\small\sffamily\itshape, align=center]
    at (0,-3.4) {``A neural network read chemistry as a graph and found a life-saving drug.''};
