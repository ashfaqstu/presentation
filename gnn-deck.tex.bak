% --- 10.1: The Equation · Formula ---
\begin{frame}[plain]
\kicker{SCENE 10 / 17 \quad THE EQUATION}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  \node[anchor=south, text=dimtext, font=\fontsize{12}{14}\selectfont\sffamily, align=center]
    at (0, 2.0) {You already understand this equation. It is the demo written down.};

  \node[anchor=center, text=chalk, font=\fontsize{17}{20}\selectfont] (eq) at (0, 0.4)
    {$\displaystyle h_v^{(k+1)} = \sigma\!\left( W \cdot
      \mathrm{AGG}\bigl(\{h_u^{(k)} : u \in \mathcal{N}(v)\}\bigr) \right)$};

  \node[anchor=north, text=dimtext, font=\small\sffamily\itshape, align=center]
    at (0, -1.4) {Do not be intimidated by the notation. Let's look at the pieces.};
\end{tikzpicture}
\end{frame}

% --- 10.2: The Equation · Callouts ---
\begin{frame}[plain]
\kicker{SCENE 10 / 17 \quad THE EQUATION}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  \node[anchor=center, text=chalk, font=\fontsize{17}{20}\selectfont] (eq) at (0, 0.5)
    {$\displaystyle h_v^{(k+1)} = \sigma\!\left( W \cdot
      \mathrm{AGG}\bigl(\{h_u^{(k)} : u \in \mathcal{N}(v)\}\bigr) \right)$};

  % Callouts
  \node[text=gold, font=\fontsize{7.5}{9}\selectfont\twfont, align=center] (lnew) at (-4.8, 2.2) {the new card};
  \draw[-{Latex[length=4pt]}, gold!60, bend right=20] (lnew.south) to (-2.6, 0.8);

  \node[text=brass, font=\fontsize{7.5}{9}\selectfont\twfont, align=center] (lsig) at (-1.4, 2.4) {"squish it"\\(activation)};
  \draw[-{Latex[length=4pt]}, brass!70, bend right=10] (lsig.south) to (-0.5, 0.9);

  \node[text=gold, font=\fontsize{7.5}{9}\selectfont\twfont, align=center] (lw) at (1.4, 2.4) {shared weights};
  \draw[-{Latex[length=4pt]}, gold!70, bend left=10] (lw.south) to (0.7, 0.9);

  \node[text=skyblue, font=\fontsize{7.5}{9}\selectfont\twfont, align=center] (lagg) at (4.2, 2.2) {shuffle-proof\\combiner};
  \draw[-{Latex[length=4pt]}, skyblue!80, bend left=20] (lagg.south) to (2.4, 0.8);

  \node[text=chalk!70, font=\fontsize{7.5}{9}\selectfont\twfont, align=center] (lnei) at (2.5, -1.8) {my neighbours};
  \draw[-{Latex[length=4pt]}, chalk!60, bend left=15] (lnei.north) to (3.2, 0.1);

  \node[anchor=south, text=gold, font=\fontsize{11}{13}\selectfont\sffamily\bfseries, align=center]
    at (0,-3.3) {Gather \quad$\cdot$\quad Aggregate \quad$\cdot$\quad Update};
\end{tikzpicture}
\end{frame}

% --- 10.3: Problem Solving · From Embeddings to Decisions ---
\begin{frame}[plain]
\kicker{HOW GNN SOLVES REAL PROBLEMS}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  \node[anchor=south, text=chalk, font=\fontsize{13}{15}\selectfont\sffamily\bfseries]
    at (0, 2.4) {From Message Passing to Predictions};

  % Pipeline cards
  \node[draw=brass!60, fill=boardmid, text=chalk, rounded corners=2pt,
        minimum width=3.0cm, minimum height=1.2cm, align=center] (b1) at (-4.2, 0.5)
    {\textbf{Raw Input $x_v$}\\[2pt]\fontsize{7}{8}\selectfont Age, Location, Posts};

  \node[draw=gold, fill=boardmid, text=gold, rounded corners=2pt, line width=1.2pt,
        minimum width=3.4cm, minimum height=1.2cm, align=center] (b2) at (0.0, 0.5)
    {\textbf{K-Layer GNN}\\[2pt]\fontsize{7}{8}\selectfont Gather $\to$ Aggregate $\to$ Update};

  \node[draw=biogreen, fill=boardmid, text=chalk, rounded corners=2pt,
        minimum width=3.0cm, minimum height=1.2cm, align=center] (b3) at (4.2, 0.5)
    {\textbf{Final Vector $h_v^{(K)}$}\\[2pt]\fontsize{7}{8}\selectfont Rich Relational Context};

  \draw[-{Latex[length=5pt]}, brass, line width=1pt] (b1) -- (b2);
  \draw[-{Latex[length=5pt]}, gold, line width=1.2pt] (b2) -- (b3);

  \node[anchor=north, text=dimtext, font=\fontsize{9.5}{12}\selectfont\sffamily, align=center]
    at (0, -1.2) {After $K$ layers, node $v$ contains the story of its entire $K$-hop neighbourhood.\\[3pt]
                  Now we can answer any question about it.};
\end{tikzpicture}
\end{frame}

