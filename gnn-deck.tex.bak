% --- 10.5: Problem Solving · The Three Graph Tasks ---
\begin{frame}[plain]
\kicker{THE THREE GRAPH PREDICTION TASKS}
\begin{tikzpicture}[remember picture,overlay,shift={(current page.center)}]
  % Card 1: Node Task
  \fill[papercream, rounded corners=3pt] (-5.6,-1.4) rectangle (-2.0,1.8);
  \node[anchor=north, text=brass!80!ink, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries] at (-3.8, 1.6) {NODE LEVEL};
  \node[anchor=north, text=ink, font=\dispfont\large\bfseries] at (-3.8, 1.15) {Classification};
  \node[anchor=north, text=ink!80, font=\fontsize{7.5}{9}\selectfont\sffamily, align=center] at (-3.8, 0.5) {
    Is this account\\a scammer?\\
    \vspace{4pt}
    $\hat{y}_v = \text{Softmax}(W h_v)$
  };

  % Card 2: Edge Task
  \fill[papercream, rounded corners=3pt] (-1.8,-1.4) rectangle (1.8,1.8);
  \node[anchor=north, text=brass!80!ink, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries] at (0, 1.6) {EDGE LEVEL};
  \node[anchor=north, text=ink, font=\dispfont\large\bfseries] at (0, 1.15) {Link Prediction};
  \node[anchor=north, text=ink!80, font=\fontsize{7.5}{9}\selectfont\sffamily, align=center] at (0, 0.5) {
    Will these two nodes\\become connected?\\
    \vspace{4pt}
    $\hat{y}_{uv} = \sigma(h_u^T h_v)$
  };

  % Card 3: Graph Task
  \fill[papercream, rounded corners=3pt] (2.0,-1.4) rectangle (5.6,1.8);
  \node[anchor=north, text=brass!80!ink, font=\fontsize{7.5}{9}\selectfont\twfont\bfseries] at (3.8, 1.6) {GRAPH LEVEL};
  \node[anchor=north, text=ink, font=\dispfont\large\bfseries] at (3.8, 1.15) {Property Test};
  \node[anchor=north, text=ink!80, font=\fontsize{7.5}{9}\selectfont\sffamily, align=center] at (3.8, 0.5) {
    Is this entire molecule\\toxic or curative?\\
    \vspace{4pt}
    $h_G = \text{Pool}(\{h_v\})$
  };

  \node[anchor=south, text=gold, font=\fontsize{11}{13}\selectfont\sffamily\bfseries, align=center]
    at (0,-3.2) {One single mechanism powers all three levels of prediction.};
\end{tikzpicture}
\end{frame}

